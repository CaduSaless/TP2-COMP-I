(* JSON simplificado: objetos, vetores, strings, numeros e literais *)
TOKENS
  STRING = /"[^"]*"/ ;
  NUMBER = /-?[0-9]+(\.[0-9]+)?/ ;
  SKIP   = /[ \t\r\n]+/ ;

RULES
  json   = valor ;
  valor  = objeto | vetor | STRING | NUMBER | "true" | "false" | "null" ;
  objeto = "{" [ membro { "," membro } ] "}" ;
  membro = STRING ":" valor ;
  vetor  = "[" [ valor { "," valor } ] "]" ;
